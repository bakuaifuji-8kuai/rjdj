<?xml version="1.0" encoding="UTF-8"?>
<!-- [软著核心代码] pom.xml - 智光云枢管廊照明管理系统 Maven 依赖管理文件 -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 项目坐标 -->
    <groupId>com.zgsq</groupId>
    <artifactId>zgsq-illumination</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <name>智光云枢管廊照明管理系统</name>
    <description>智光云枢 - 城市地下综合管廊照明智能管控平台后端服务</description>

    <!-- 父项目：SpringBoot 2.7.18 -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.7.18</version>
        <relativePath/>
    </parent>

    <!-- 全局属性：Java 8 编译，确保高版本 JDK 环境兼容 -->
    <properties>
        <java.version>1.8</java.version>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- 三方依赖版本锁定 -->
        <mybatis-plus.version>3.5.3.1</mybatis-plus.version>    </properties>

    <dependencies>
        <!-- ========== SpringBoot 基础起步依赖 ========== -->
        <!-- Web 起步：内嵌 Tomcat + Spring MVC -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- AOP 起步：用于操作日志切面 LogAspect -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>
        <!-- Validation 起步：参数校验（@NotBlank/@Size 等） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- ========== MyBatis-Plus 3.5.3.1 ========== -->
        <!-- MyBatis-Plus Boot Starter：封装自动配置、分页插件、通用 CRUD -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-boot-starter</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>

        <!-- ========== MySQL 驱动 ========== -->
        <!-- 适配 MySQL 5.7，使用 8.x 驱动兼容向下兼容 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>


        <!-- Lombok: 编译期注解处理器, 升级到 1.18.36 支持 JDK 25 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.36</version>
        </dependency>

        <!-- ========== Hutool 工具库 ========== -->
        <!-- 引入少量 hutool-all 中的 Excel/加密/日期 工具类 -->
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-all</artifactId>
            <version>5.8.25</version>
        </dependency>

        <!-- ========== Apache POI：Excel 导入导出 ========== -->
        <!-- GuanLangExcelUtil 导出 Excel 模板、解析用户导入数据 -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.2.5</version>
        </dependency>

        <!-- ========== Druid 数据库连接池 ========== -->
        <!-- 高性能连接池，自带监控；可替换为 HikariCP -->
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>druid-spring-boot-starter</artifactId>
            <version>1.2.20</version>
        </dependency>

        <!-- ========== 测试依赖 ========== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    <!-- H2 内存数据库（开发/验证用，软著运行需 MySQL 5.7） -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <version>2.2.224</version>
      <scope>runtime</scope>
    </dependency>

    </dependencies>

    <build>
        <finalName>zgsq-illumination</finalName>
        <plugins>
            <!-- SpringBoot Maven 插件：打包可执行 jar -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.zgsq.illumination.ZhiGuangApplication</mainClass>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
            <!-- 编译插件：再次锁定 Java 8 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>1.8</source>
                    <target>1.8</target>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>
        </plugins>
        <!-- 资源过滤：确保 MyBatis XML 随 jar 打包 -->
        <resources>
            <resource>
                <directory>src/main/java</directory>
                <includes>
                    <include>**/*.xml</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <includes>
                    <include>**/*</include>
                </includes>
            </resource>
        </resources>
    </build>
</project>
